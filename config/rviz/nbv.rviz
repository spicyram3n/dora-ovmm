Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Occupied cells1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 10
      Color: 160; 160; 164
      Alpha: 0.5
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.3
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Occupied cells
      Enabled: true
      Topic:
        Value: /nbv/occupied
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Style: Boxes
      Size (m): 0.05
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: Intensity
      Channel Name: intensity
      Use rainbow: true
      Invert Rainbow: true
      Autocompute Intensity Bounds: false
      Min Intensity: 0.5
      Max Intensity: 1
      Selectable: true
    - Class: rviz_default_plugins/Marker
      Name: Target sphere
      Enabled: true
      Topic:
        Value: /nbv/sphere
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.4
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_footprint
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 2.5
      Focal Point:
        X: 0.5
        Y: 0
        Z: 1.1
      Pitch: 0.35
      Yaw: 3.0
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
