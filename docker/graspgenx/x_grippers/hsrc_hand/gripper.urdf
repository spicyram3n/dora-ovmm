    <child link="hand_palm_link" />
  </joint>
  <link name="hand_palm_link">
    <inertial>
      <mass value="0.15" />
      <inertia ixx="0.015" ixy="0.0" ixz="0.0" iyy="0.015" iyz="0.0" izz="0.015" />
    </inertial>
