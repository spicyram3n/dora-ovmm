      </geometry>
    </collision>
  </link>
  <joint name="hand_motor_joint" type="revolute">
    <axis xyz="1.0 0.0 0.0" />
    <limit effort="100.0" lower="-0.798" upper="1.24" velocity="1.0" />
    <parent link="hand_palm_link" />
    <child link="hand_motor_dummy_link" />
    <dynamics damping="0.0001" />
  </joint>
