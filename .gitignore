# Python
__pycache__/
*.pyc

# ROS 2 colcon build artifacts (regenerated by colcon build)
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# Everything under ros2_ws/src/ is a separately cloned vendor repo
# (its own .git directory) except grasp_execution/, which is ours.
ros2_ws/src/*
!ros2_ws/src/grasp_execution/

# Secrets: HF_TOKEN and the cached HF login it produces
docker/sam3/.env
docker/sam3/checkpoints/

# GraspGenX model weights (multi-GB, not source)
docker/graspgenx/checkpoints/

# Generated per-run outputs from core/run_pipeline.py, not source
config/grasps/*.yaml
config/grasps/*.png
