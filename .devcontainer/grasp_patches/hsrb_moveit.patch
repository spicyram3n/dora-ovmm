diff --git a/hsrb_moveit_config/scripts/depth_camera_relay.py b/hsrb_moveit_config/scripts/depth_camera_relay.py
new file mode 100755
index 0000000..a257a38
--- /dev/null
+++ b/hsrb_moveit_config/scripts/depth_camera_relay.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""Publish smaller depth/CameraInfo pairs for the simulation octomap updater.
+
+The original depth stream is also kept for full-resolution grasp perception.
+No point-cloud topic is consumed or produced.
+"""
+from copy import deepcopy
+import numpy as np
+import rclpy
+from rclpy.node import Node
+from sensor_msgs.msg import CameraInfo, Image
+from cv_bridge import CvBridge
+
+
+class DepthCameraRelay(Node):
+    def __init__(self):
+        super().__init__('octomap_depth_camera')
+        self.info = None
+        self.bridge = CvBridge()
+        self.image_pub = self.create_publisher(Image, '/octomap_camera/image', 5)
+        self.info_pub = self.create_publisher(CameraInfo, '/octomap_camera/camera_info', 5)
+        # Reliable input avoids losing fragmented 1.2 MB simulator images.
+        self.create_subscription(CameraInfo, '/head_rgbd_sensor/depth_registered/camera_info', self.on_info, 5)
+        self.create_subscription(Image, '/head_rgbd_sensor/depth_registered/image', self.on_image, 5)
+
+    def on_info(self, msg):
+        self.info = msg
+
+    def on_image(self, msg):
+        if self.info is None:
+            return
+        if (msg.width, msg.height, msg.header.frame_id) != (self.info.width, self.info.height, self.info.header.frame_id):
+            self.get_logger().error('Depth/calibration dimensions or frames differ')
+            return
+        # Decimation selects actual samples, without averaging depth edges.
+        raw = self.bridge.imgmsg_to_cv2(msg, desired_encoding='passthrough')
+        image = self.bridge.cv2_to_imgmsg(np.ascontiguousarray(raw[::2, ::2]), encoding=msg.encoding)
+        image.header = msg.header
+        info = deepcopy(self.info)
+        info.header = msg.header
+        info.width, info.height = image.width, image.height
+        for index in (0, 1, 2, 3, 4, 5):
+            info.k[index] /= 2
+        for index in range(8):
+            info.p[index] /= 2
+        self.image_pub.publish(image)
+        self.info_pub.publish(info)
+
+
+def main():
+    rclpy.init()
+    node = DepthCameraRelay()
+    try:
+        rclpy.spin(node)
+    finally:
+        node.destroy_node()
+        rclpy.shutdown()
+
+
+if __name__ == '__main__':
+    main()
diff --git a/hsrb_moveit_config/src/configured_depth_updater.cpp b/hsrb_moveit_config/src/configured_depth_updater.cpp
new file mode 100644
index 0000000..2f06259
--- /dev/null
+++ b/hsrb_moveit_config/src/configured_depth_updater.cpp
@@ -0,0 +1,125 @@
+#include <moveit/depth_image_octomap_updater/depth_image_octomap_updater.h>
+#include <moveit/occupancy_map_monitor/occupancy_map_monitor.h>
+#include <pluginlib/class_list_macros.hpp>
+#include <moveit_msgs/msg/collision_object.hpp>
+#include <mutex>
+#include <cmath>
+#include <Eigen/Geometry>
+#include <vector>
+#include <limits>
+
+namespace hsr_rgbd {
+// Humble initializes updaters before setParams(). The native depth updater
+// configures its GL mesh filter only in initialize(), leaving clipping and
+// padding at constructor defaults. Reinitialize before any shapes are added.
+class ConfiguredDepthUpdater : public occupancy_map_monitor::DepthImageOctomapUpdater {
+ public:
+  bool initialize(const rclcpp::Node::SharedPtr& node) override {
+    node_ = node;
+    if (!DepthImageOctomapUpdater::initialize(node)) return false;
+    exclusion_ = node->create_subscription<moveit_msgs::msg::CollisionObject>(
+        "/octomap_target_exclusion", 1, [this](moveit_msgs::msg::CollisionObject::ConstSharedPtr msg) {
+          std::lock_guard<std::mutex> lock(mutex_);
+          if (msg->id != "grasp_target") return;
+          if (msg->operation == moveit_msgs::msg::CollisionObject::REMOVE) { active_ = false; return; }
+          active_ = false;
+          planes_.clear();
+          if (msg->header.frame_id != "odom") return;
+          if (msg->meshes.size() == 1 && msg->mesh_poses.size() == 1 && msg->primitives.empty()) {
+            // Mesh vertices are explicitly in odom; reject transforms rather
+            // than silently filtering in the wrong frame.
+            const auto& pose = msg->mesh_poses[0];
+            if (pose.position.x != 0 || pose.position.y != 0 || pose.position.z != 0 ||
+                pose.orientation.x != 0 || pose.orientation.y != 0 || pose.orientation.z != 0 || pose.orientation.w != 1 ||
+                msg->pose.position.x != 0 || msg->pose.position.y != 0 || msg->pose.position.z != 0 ||
+                msg->pose.orientation.x != 0 || msg->pose.orientation.y != 0 || msg->pose.orientation.z != 0 ||
+                (msg->pose.orientation.w != 0 && msg->pose.orientation.w != 1)) return;
+            const auto& mesh=msg->meshes[0];
+            if (mesh.vertices.size()<4 || mesh.triangles.size()<4) return;
+            Eigen::Vector3d center=Eigen::Vector3d::Zero();
+            minimum_=Eigen::Vector3d::Constant(std::numeric_limits<double>::infinity());
+            maximum_=-minimum_;
+            for (const auto& p:mesh.vertices) {
+              Eigen::Vector3d v(p.x,p.y,p.z);
+              if (!v.allFinite()) return;
+              minimum_=minimum_.cwiseMin(v); maximum_=maximum_.cwiseMax(v);center+=v;
+            }
+            center/=mesh.vertices.size();
+            if ((maximum_-minimum_).minCoeff()<.008 || (maximum_-minimum_).maxCoeff()>.45) return;
+            for (const auto& t:mesh.triangles) {
+              Eigen::Vector3d v[3];
+              for(int k=0;k<3;++k) {
+                if(t.vertex_indices[k]>=mesh.vertices.size())return;
+                const auto& p=mesh.vertices[t.vertex_indices[k]];v[k]=Eigen::Vector3d(p.x,p.y,p.z);
+              }
+              Eigen::Vector3d normal=(v[1]-v[0]).cross(v[2]-v[0]);
+              if(normal.norm()<1e-12)return;
+              normal.normalize();if(normal.dot(v[0]-center)<0)normal=-normal;
+              planes_.emplace_back(normal.x(),normal.y(),normal.z(),-normal.dot(v[0]));
+            }
+            lo_=minimum_.z();hi_=maximum_.z();active_=true;return;
+          }
+          if (msg->header.frame_id != "odom" || msg->primitives.size() != 1 ||
+              msg->primitive_poses.size() != 1 || msg->primitives[0].type != 3 ||
+              msg->primitives[0].dimensions.size() != 2) return;
+          const auto& p = msg->primitive_poses[0];
+          const double h = msg->primitives[0].dimensions[0], r = msg->primitives[0].dimensions[1];
+          if (!std::isfinite(p.position.x) || !std::isfinite(p.position.y) ||
+              !std::isfinite(p.position.z) || !std::isfinite(h) || !std::isfinite(r) ||
+              h < .04 || h > .4 || r < .015 || r > .06 ||
+              p.orientation.x != 0 || p.orientation.y != 0 || p.orientation.z != 0 || p.orientation.w != 1) return;
+          x_ = p.position.x; y_ = p.position.y;
+          lo_ = p.position.z - h / 2; hi_ = p.position.z + h / 2; radius_ = r;
+          active_ = true;
+        });
+    cleanup_ = node->create_wall_timer(std::chrono::milliseconds(200), [this]() {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (!active_ || !tree_ || monitor_->getMapFrame() != "odom") return;
+      // Clear voxel centres only within the fitted upright target. Preserve
+      // cells at/below its base (including the supporting tabletop). A single
+      // voxel of radial tolerance covers depth quantisation at the surface.
+      tree_->lockWrite();
+      bool changed = false;
+      const double step = tree_->getResolution(), r = radius_ + step;
+      const double xmin=planes_.empty()?x_-r:minimum_.x()-step;
+      const double xmax=planes_.empty()?x_+r:maximum_.x()+step;
+      const double ymin=planes_.empty()?y_-r:minimum_.y()-step;
+      const double ymax=planes_.empty()?y_+r:maximum_.y()+step;
+      for (double x = std::floor(xmin / step) * step + step / 2; x < xmax; x += step)
+        for (double y = std::floor(ymin / step) * step + step / 2; y < ymax; y += step) {
+          if (planes_.empty() && (x-x_)*(x-x_) + (y-y_)*(y-y_) > r*r) continue;
+          for (double z = std::floor(lo_ / step) * step + step / 2; z <= hi_ + (planes_.empty() ? 0. : step); z += step) {
+            if (z <= lo_) continue;
+            bool inside=true;
+            for(const auto& p:planes_)if(p.x()*x+p.y()*y+p.z()*z+p.w()>step) {inside=false;break;}
+            if(!inside)continue;
+            auto* existing = tree_->search(x, y, z);
+            if (existing && tree_->isNodeOccupied(existing)) {
+              // Update only this leaf's ancestors; walking the entire map on
+              // every timer tick can starve MoveIt's action callbacks.
+              tree_->setNodeValue(tree_->coordToKey(x, y, z), tree_->getClampingThresMinLog(), false);
+              changed = true;
+            }
+          }
+        }
+      tree_->unlockWrite();
+      if (changed) tree_->triggerUpdateCallback();
+    });
+    return true;
+  }
+  bool setParams(const std::string& ns) override {
+    if (!DepthImageOctomapUpdater::setParams(ns)) return false;
+    return DepthImageOctomapUpdater::initialize(node_);
+  }
+ private:
+  rclcpp::Node::SharedPtr node_;
+  rclcpp::Subscription<moveit_msgs::msg::CollisionObject>::SharedPtr exclusion_;
+  rclcpp::TimerBase::SharedPtr cleanup_;
+  std::mutex mutex_;
+  std::vector<Eigen::Vector4d> planes_;
+  Eigen::Vector3d minimum_,maximum_;
+  bool active_ = false;
+  double x_ = 0, y_ = 0, lo_ = 0, hi_ = 0, radius_ = 0;
+};
+}
