 def add_joints_and_links(robot_description_content):
     root = ET.fromstring(robot_description_content)
+    # Gazebo uses a zero-travel revolute joint for the wrist force sensor.
+    # It is mechanically fixed and must not become a ninth planning DOF:
+    # the HSR analytic solver returns exactly five arm + three base values.
+    for joint in root.findall('joint'):
+        limit = joint.find('limit')
+        if (joint.get('type') in ('revolute', 'prismatic') and limit is not None and
+                limit.get('lower') is not None and limit.get('upper') is not None and
+                float(limit.get('lower')) == 0.0 and float(limit.get('upper')) == 0.0):
+            joint.set('type', 'fixed')
+            joint.remove(limit)
+            axis = joint.find('axis')
+            if axis is not None:
+                joint.remove(axis)
     root.append(link('odom'))
     root.append(link('odom_xt_link'))
     root.append(link('odom_yx_link'))
