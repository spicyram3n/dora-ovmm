diff --git a/hsrb_gz_ros2_control/include/hsrb_gz_ros2_control/mimic_velocity.hpp b/hsrb_gz_ros2_control/include/hsrb_gz_ros2_control/mimic_velocity.hpp
new file mode 100644
index 0000000..a5fc1f6
--- /dev/null
+++ b/hsrb_gz_ros2_control/include/hsrb_gz_ros2_control/mimic_velocity.hpp
@@ -0,0 +1,17 @@
+#ifndef HSRB_GZ_ROS2_CONTROL_MIMIC_VELOCITY_HPP_
+#define HSRB_GZ_ROS2_CONTROL_MIMIC_VELOCITY_HPP_
+
+#include <algorithm>
+
+namespace hsrb_gz_ros2_control {
+// Track measured source motion, including passive spring deflection. The
+// desired position is constrained by the mimic joint's own URDF limits.
+inline double MimicVelocity(double source_position, double source_velocity,
+    double position, double multiplier, double offset, double lower,
+    double upper, double max_velocity) {
+  const double target = std::clamp(multiplier * source_position + offset, lower, upper);
+  return std::clamp(20.0 * (target - position) + multiplier * source_velocity,
+      -max_velocity, max_velocity);
+}
+}  // namespace hsrb_gz_ros2_control
+#endif  // HSRB_GZ_ROS2_CONTROL_MIMIC_VELOCITY_HPP_
diff --git a/hsrb_gz_ros2_control/test/test_mimic_velocity.cpp b/hsrb_gz_ros2_control/test/test_mimic_velocity.cpp
new file mode 100644
index 0000000..1c4c69a
--- /dev/null
+++ b/hsrb_gz_ros2_control/test/test_mimic_velocity.cpp
@@ -0,0 +1,24 @@
+#include <cmath>
+#include <stdexcept>
+#include "hsrb_gz_ros2_control/mimic_velocity.hpp"
+
+int main() {
+  using hsrb_gz_ros2_control::MimicVelocity;
+  auto require = [](bool condition) {
+    if (!condition) {throw std::runtime_error("Mimic tracking regression");}
+  };
+  // A settled motor still requires the fixed distal offset.
+  require(MimicVelocity(.46, 0., -.46, -1., -.087, -1.24, .798, 1.) < 0.);
+  require(std::abs(MimicVelocity(.46, 0., -.547, -1., -.087, -1.24, .798, 1.)) < 1.e-12);
+  // Passive spring deflection must be counter-rotated, even at zero velocity.
+  require(MimicVelocity(.135, 0., 0., -1., 0., -.698, 0., 1.) == -1.);
+  double position = 0.;
+  for (int i = 0; i < 200; ++i) {
+    const double velocity = MimicVelocity(.135, 0., position, -1., 0., -.698, 0., 1.);
+    require(std::abs(velocity) <= 1.);
+    position += .005 * velocity;
+  }
+  require(std::abs(position + .135) < .0001);
+  require(MimicVelocity(2., 0., -.698, -1., 0., -.698, 0., 1.) == 0.);
+  return 0;
+}
