ROS_DOMAIN_ID=5
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///home/ws/.devcontainer/cyclonedds_profile.xml
RECORDING=lab_20260919_wheel

# Real-robot mode for everything started from a terminal: the robot's clock and the
# /remote camera topics (core/perception/camera_ros2.py), and the recording's own
# scene graph as the mission's default. This file already is the real-robot switch
# (domain 5, the robot's DDS profile). For the simulator, run with `HSR_REAL_ROBOT= `
# in front of the command, or take this file out of the way.
HSR_REAL_ROBOT=1
