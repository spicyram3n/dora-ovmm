{
    "name": "HSR Scene Graph Dev Container",
    "privileged": true,
    "remoteUser": "hsr",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".",
        "args": {
            "USERNAME": "hsr",
            "DOCKER_REPO": "osrf/ros",
            "ROS_DISTRO": "humble",
            "IMAGE_SUFFIX": "-desktop-full"
        }
    },
    "workspaceFolder": "/home/ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/ws,type=bind",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "eamodio.gitlens",
                "ms-iot.vscode-ros",
                "ms-python.black-formatter",
                "anthropic.claude-code",
                "openai.chatgpt"
            ]
        }
    },
    "containerEnv": {
        "ROS_LOCALHOST_ONLY": "0",
        "NVIDIA_DRIVER_CAPABILITIES": "all",
        "RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp",
        "GZ_SIM_RESOURCE_PATH": "/home/ws/ros2_ws/install/tmc_gazebo_worlds/share/tmc_gazebo_worlds/models",
        "IGN_GAZEBO_RESOURCE_PATH": "/home/ws/ros2_ws/install/tmc_gazebo_worlds/share/tmc_gazebo_worlds/models"
    },
    "hostRequirements": {
        "gpu": "optional"
    },
    "runArgs": [
        "--net=host",
        "-e", "DISPLAY=${localEnv:DISPLAY}",
        "--ulimit", "memlock=-1:-1",
        "--ulimit", "rtprio=99",
        "--shm-size=8g"
    ],
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
        "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached",
        "source=${localEnv:HOME}/rosbags/playable_bag,target=/home/ws/bags/playable_bag,type=bind,readonly"
    ],
    "initializeCommand": "sh ./.devcontainer/initialize.sh",
    "postCreateCommand": "bash ./.devcontainer/postCreate.sh"
}
