# Where to stand and look next, to learn the most about a sphere.
geometry_msgs/Point centre   # in the map's frame (the node's `frame` parameter)
float64 radius               # metres
---
bool found                   # false when nothing the robot can reach sees anything
# Where to stand, in the same frame. Only meaningful when the node runs in a
# fixed frame: under base_footprint the robot is always at the origin of it.
float64 base_x
float64 base_y
float64 base_yaw
float64 lift                 # arm_lift_joint; the head rides up at half its rate
float64 pan                  # head_pan_joint
float64 tilt                 # head_tilt_joint
uint32 bits                  # unknown cells the view would uncover
