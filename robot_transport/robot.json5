{
  "mode": "router",
  "listen": {
    "endpoints": [
      "tcp/0.0.0.0:7449"
    ]
  },
  "scouting": {
    "multicast": {
      "enabled": false
    },
    "gossip": {
      "enabled": false
    }
  },
  "plugins": {
    "ros2dds": {
      "domain": 5,
      "allow": {
        "publishers": [
          "^/scan$",
          "^/odom$",
          "^/joint_states$",
          "^/tf$",
          "^/tf_static$",
          "^/map$",
          "^/clock$",
          "^/head_rgbd_sensor/rgb/camera_info$",
          "^/zenoh/rgbd/rgb/compressed$",
          "^/zenoh/rgbd/depth/compressedDepth$"
        ],
        "subscribers": [
          "^/tf$",
          "^/map$",
          "^/initialpose$"
        ],
        "action_servers": [
          "^/compute_path_to_pose$",
          "^/navigate_to_pose$",
          "^/head_trajectory_controller/follow_joint_trajectory$"
        ],
        "action_clients": [],
        "service_servers": [],
        "service_clients": []
      },
      "pub_priorities": [
        "/tf=1:express",
        "/scan=2:express",
        "/zenoh/rgbd/.*=6"
      ],
      "queries_timeout": {
        "actions": {
          "send_goal": 5.0,
          "cancel_goal": 5.0,
          "get_result": 3600.0
        }
      }
    }
  }
}
